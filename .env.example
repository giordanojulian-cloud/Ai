# ---------------------------------------------------------------------------
# CalcForge environment variables. Every integration is optional — the site
# builds and runs with none of them. Copy to .env and fill in what you need.
# ---------------------------------------------------------------------------

# Public URL (canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database (PostgreSQL; Supabase, Neon, RDS or local) --------------------
# Required for accounts, saved calculations, feedback, newsletter and admin.
DATABASE_URL="postgresql://calcforge:calcforge@localhost:5432/calcforge"

# --- Authentication (Auth.js) -----------------------------------------------
# Generate with: npx auth secret   (required in production)
AUTH_SECRET=""
# OAuth providers — each is enabled only when both values are set.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email magic links via Resend (requires DATABASE_URL).
AUTH_RESEND_KEY=""
AUTH_EMAIL_FROM="CalcForge <login@example.com>"
# Local development only: password-less "dev login" form on /signin.
AUTH_DEV_LOGIN="false"
# Comma-separated emails that get the ADMIN role when they sign in.
ADMIN_EMAILS=""
# Optional: `npm run db:seed` creates this admin user.
SEED_ADMIN_EMAIL=""

# --- Billing (Stripe) -------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_ANNUAL=""

# --- AI explanations (Anthropic) --------------------------------------------
# When unset, the "Explain my result" button is hidden.
ANTHROPIC_API_KEY=""
# Optional model override (defaults to claude-opus-5).
AI_MODEL=""

# --- Analytics --------------------------------------------------------------
# plausible | posthog | ga4 | console | none
NEXT_PUBLIC_ANALYTICS_PROVIDER="none"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# --- Advertising & monetization ---------------------------------------------
# off | placeholder | adsense
NEXT_PUBLIC_ADS_MODE="off"
NEXT_PUBLIC_ADSENSE_CLIENT=""
NEXT_PUBLIC_ADSENSE_SLOT_BELOW_RESULT=""
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=""
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=""
# Show labeled placeholders for every ad/affiliate/lead-gen slot (local design work).
NEXT_PUBLIC_MONETIZATION_PREVIEW="false"
