// CalcForge database schema.
//
// Design notes:
// - Calculation logic and default content live in code (src/calculators). The
//   `Calculator` table stores editorial overrides managed from /admin, so the
//   public site keeps working (from code defaults) when the database is down.
// - We deliberately do not log every calculation. Saved calculations are
//   explicit user actions and store only the calculator inputs.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum PlanTier {
  FREE
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

enum CalculatorStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SuggestionStatus {
  NEW
  PLANNED
  BUILT
  DECLINED
}

// ---------------------------------------------------------------------------
// Auth.js models (https://authjs.dev/getting-started/adapters/prisma)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts            Account[]
  sessions            Session[]
  savedCalculations   SavedCalculation[]
  calculationHistory  CalculationHistory[]
  favorites           FavoriteCalculator[]
  subscription        PremiumSubscription?
  feedback            Feedback[]
  suggestions         CalculatorSuggestion[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model CalculatorCategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calculators Calculator[]
}

/// Editorial record for a calculator. Every column except `slug` is an
/// optional override of the code-defined default in src/calculators.
model Calculator {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String?
  shortDescription String?
  description      String?
  seoTitle         String?
  seoDescription   String?
  keywords         String[]          @default([])
  categoryId       String?
  featured         Boolean?
  premium          Boolean?
  status           CalculatorStatus?
  /// JSON array of { question, answer }. Replaces code FAQs when set.
  faqs             Json?
  /// Ordered slugs. Replaces code related calculators when non-empty.
  relatedSlugs     String[]          @default([])
  /// Reserved for future config-driven calculators; not executed today.
  config           Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  category CalculatorCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// User data
// ---------------------------------------------------------------------------

model SavedCalculation {
  id             String   @id @default(cuid())
  userId         String
  calculatorSlug String
  name           String
  /// Calculator inputs only (numbers/options). Results are recomputed on load.
  inputs         Json
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

/// Opt-in history for premium "historical comparisons". Not written in the
/// MVP; kept separate from SavedCalculation so retention rules can differ.
model CalculationHistory {
  id             String   @id @default(cuid())
  userId         String
  calculatorSlug String
  inputs         Json
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model FavoriteCalculator {
  userId         String
  calculatorSlug String
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, calculatorSlug])
}

model PremiumSubscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  tier                 PlanTier           @default(PRO)
  status               SubscriptionStatus
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Audience & feedback
// ---------------------------------------------------------------------------

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  source         String?
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Feedback {
  id             String   @id @default(cuid())
  calculatorSlug String
  helpful        Boolean
  comment        String?
  userId         String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([calculatorSlug, createdAt])
}

model CalculatorSuggestion {
  id          String           @id @default(cuid())
  title       String
  description String?
  email       String?
  status      SuggestionStatus @default(NEW)
  userId      String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}
